# Copy this file to .env and replace the placeholder with a private value.
JWT_SECRET=replace-with-a-long-random-secret
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
METERED_API_KEY=your-metered-api-key
METERED_CREDENTIALS_URL=https://your-metered-subdomain.metered.live/api/v1/turn/credentials
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_TIMEOUT=60000ms
# Login OTP: keep debug enabled for local/mobile testing, or configure SMTP below.
LOGIN_OTP_EMAIL_ENABLED=false
LOGIN_OTP_DEBUG_ENABLED=true
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
